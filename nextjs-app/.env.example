# ---------------------------------------------------------------------------
# Nitte FPC Inventory — settings. Copy to ".env" and fill in.
# (On Cloudflare, set these with `npx wrangler secret put NAME` or in wrangler.jsonc "vars".)
# ---------------------------------------------------------------------------

# PostgreSQL connection
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nfpc_inventory

# Address other computers use to open the app, e.g. http://192.168.1.20:3000 or https://inventory.example.org
# Needed for links in emails when the app isn't opened via localhost. Blank = the address in the browser (localhost only).
APP_URL=

# Email for "Forgot password" links:  none | smtp | resend
#   none   — requests appear under Users & roles → Reset requests instead
#   smtp   — any SMTP server, e.g. Gmail with an App password (local / Node.js hosting)
#   resend — https://resend.com HTTP API (recommended on Cloudflare)
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_FROM_NAME=Nitte FPC Inventory

# SMTP (Gmail: turn on 2-Step Verification, create an App password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (port 465) | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Resend
RESEND_API_KEY=

# Only for `npm run import:mysql` (copying data from the old PHP/MySQL system)
MYSQL_URL=mysql://nfpc_app:PASSWORD@127.0.0.1:3306/nfpc_inventory
